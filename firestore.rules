rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function userRole() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function activeUser() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /_collectionSchemas/{collectionName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /patients/{patientId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.patientUid == request.auth.uid)
        || (signedIn() && resource.data.assignedDoctorUid == request.auth.uid);
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.assignedDoctorUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participantUids);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid in request.resource.data.participantUids);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participantUids);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAdmin()
          || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids);
        allow update: if isAdmin()
          || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids);
        allow delete: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && (isAdmin() || resource.data.recipientUid == request.auth.uid);
      allow create: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /patientDocuments/{documentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.patientUid == request.auth.uid)
        || (signedIn() && resource.data.assignedDoctorUid == request.auth.uid);
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.assignedDoctorUid == request.auth.uid)
        || (signedIn() && request.resource.data.patientUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /doctorProfiles/{doctorUid} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == doctorUid);
      allow delete: if isAdmin();
    }

    match /availability/{availabilityId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin()
        || (signedIn() && resource.data.doctorUid == request.auth.uid)
        || (signedIn() && request.resource.data.doctorUid == request.auth.uid);
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.patientUid == request.auth.uid)
        || (signedIn() && resource.data.doctorUid == request.auth.uid);
      allow create, update, delete: if isAdmin()
        || (signedIn() && request.resource.data.doctorUid == request.auth.uid);
    }

    match /encounters/{encounterId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.doctorUid == request.auth.uid)
        || (signedIn() && resource.data.patientUid == request.auth.uid);
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.doctorUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Patient-key lookup documents are server-only. The API resolves public
    // patient IDs and prevents duplicate registration through a transaction.
    match /patientKeys/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
